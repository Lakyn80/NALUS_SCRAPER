# LLM provider (deepseek / openai)
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here
LLM_MODEL_DEEPSEEK=deepseek-v4-flash
LLM_TIMEOUT=30
LLM_MAX_TOKENS=800

# Qdrant — dev API uses combined BGE-M3 candidate (not nalus_live)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=nalus_us_bge_m3_rag_combined_20260709

# Optional exact query cache
RAG_QUERY_CACHE_BACKEND=none
RAG_QUERY_CACHE_URL=redis://redis:6379/0
RAG_QUERY_CACHE_TTL_SECONDS=604800
RAG_QUERY_CACHE_PROMPT_VERSION=v1

# RAG
RAG_STRICT_REAL_MODE=1
NALUS_BATCHES_DIR=/app/batches
NALUS_CHUNK_SIZE=1500
NALUS_CHUNK_OVERLAP=200
RETRIEVAL_PROFILE=nalus_bge_m3_dense_bm25_rrf_v1
RETRIEVAL_MODE=dense_plus_bm25
BM25_SIDECAR_PATH=/app/storage/rag/bm25/nalus_us_bge_m3_rag_combined_20260709.sqlite
BM25_INDEX_ID=nalus_bge_m3_dense_bm25_rrf_v1
NALUS_RETRIEVAL_CANDIDATE_MULTIPLIER=6
NALUS_RETRIEVAL_MIN_CANDIDATES=50
NALUS_RETRIEVAL_MAX_CANDIDATES=500
NALUS_RETRIEVAL_LEXICAL_FILTER_ENABLED=1

# Additive document-level retrieval endpoint (/api/rag/retrieve-documents).
# Disabled by default so existing chunk-level retrieval remains unchanged.
NALUS_DOCUMENT_RETRIEVAL_ENABLED=0
NALUS_DOCUMENT_MAX_CANDIDATE_CHUNKS=200
NALUS_DOCUMENT_MAX_RETURNED_DOCUMENTS=50
NALUS_DOCUMENT_MAX_SUPPORTING_CHUNKS_PER_DOCUMENT=3
NALUS_DOCUMENT_RELEVANCE_THRESHOLD=0.0
NALUS_DOCUMENT_SCORING_STRATEGY=best_plus_average_top_chunks
# Optional latency budget for diagnostics only; no hidden fallback is applied.
# NALUS_DOCUMENT_LATENCY_BUDGET_MS=1500

# Additive constraint-aware verified retrieval endpoint (/api/rag/retrieve-verified).
# Disabled by default. The endpoint verifies hard query constraints against
# bounded full-document text and returns no documents when constraints are not proven.
NALUS_CONSTRAINT_RETRIEVAL_ENABLED=0
NALUS_CONSTRAINT_RETRIEVAL_STRICT_MODE=1
NALUS_CONSTRAINT_MAX_CANDIDATE_CHUNKS=200
NALUS_CONSTRAINT_MAX_CANDIDATE_DOCUMENTS=50
NALUS_CONSTRAINT_MAX_RETURNED_DOCUMENTS=20
NALUS_CONSTRAINT_MAX_SUPPORTING_CHUNKS=3
NALUS_CONSTRAINT_MAX_CHUNKS_PER_DOCUMENT_FOR_VERIFICATION=24
NALUS_CONSTRAINT_MAX_DOCUMENT_CHARACTERS_FOR_VERIFICATION=40000
NALUS_CONSTRAINT_TOTAL_LATENCY_BUDGET_MS=10000
NALUS_CONSTRAINT_DOCUMENT_VERIFICATION_TIMEOUT_MS=1500
NALUS_CONSTRAINT_STRUCTURED_QUERY_STRATEGY=deterministic_v1
NALUS_CONSTRAINT_VERIFICATION_STRATEGY=deterministic_v1
NALUS_CONSTRAINT_RANKING_STRATEGY=retrieval_plus_constraint_coverage_v1
NALUS_CONSTRAINT_INCLUDE_REJECTED_DOCUMENTS=0

# Additive Legal Retrieval v2 endpoint (/api/rag/search-v2).
# Disabled by default and not production traffic.
NALUS_LEGAL_V2_SEARCH_ENABLED=0
NALUS_LEGAL_V2_CASE_SIMILARITY_ENABLED=1
NALUS_LEGAL_V2_QDRANT_COLLECTION=nalus_legal_paragraph_chunks_v2_pilot_600
NALUS_LEGAL_V2_BM25_SIDECAR_PATH=/app/storage/rag/bm25/nalus_legal_paragraph_bm25_v2_pilot_600.sqlite
NALUS_LEGAL_V2_BM25_INDEX_ID=nalus_legal_paragraph_bm25_v2_pilot_600
NALUS_LEGAL_V2_DEFAULT_RESULT_LIMIT=10
NALUS_LEGAL_V2_MAX_RESULT_LIMIT=20
NALUS_LEGAL_V2_DEBUG=0
NALUS_LEGAL_V2_DENSE_CANDIDATE_CHUNKS=80
NALUS_LEGAL_V2_BM25_CANDIDATE_CHUNKS=80
NALUS_LEGAL_V2_FUSED_CANDIDATE_CHUNKS=120
NALUS_LEGAL_V2_CANDIDATE_DOCUMENTS=40
NALUS_LEGAL_V2_RETURNED_VERIFIED_DOCUMENTS=10
NALUS_LEGAL_V2_EVIDENCE_WINDOWS_PER_CONSTRAINT=2
NALUS_LEGAL_V2_QUERYSPEC_TIMEOUT_SECONDS=120
NALUS_LEGAL_V2_QUERYSPEC_MAX_PROVIDER_ATTEMPTS=3
NALUS_LEGAL_V2_VERIFIER_TIMEOUT_SECONDS=30
NALUS_LEGAL_V2_VERIFIER_THINKING_TIMEOUT_SECONDS=120
NALUS_LEGAL_V2_VERIFIER_THINKING_FALLBACK=1
NALUS_LEGAL_V2_VERIFIER_THINKING_FALLBACK_MAX_PER_QUERY=2
NALUS_LEGAL_V2_VERIFIER_MAX_CANDIDATES_PER_QUERY=8
# Extra attempts after empty_message_content (thinking defaults higher than fast)
NALUS_LEGAL_V2_VERIFIER_EMPTY_CONTENT_RETRIES=3
NALUS_LEGAL_V2_VERIFIER_EMPTY_CONTENT_RETRIES_FAST=1

# Embedding — offline BGE-M3; use HF cache snapshot path inside Docker if ./models is empty
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL_NAME=/root/.cache/huggingface/hub/models--BAAI--bge-m3/snapshots/REPLACE_WITH_SNAPSHOT_HASH
EMBEDDING_DIMENSION=1024
EMBEDDING_LOCAL_FILES_ONLY=1
EMBEDDING_TRUST_REMOTE_CODE=0
EMBEDDING_DEVICE=cpu
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# Redis embedding cache (optional; default disabled)
REDIS_URL=redis://redis:6379/1
EMBEDDING_CACHE_ENABLED=0
EMBEDDING_CACHE_KEY_PREFIX=nalus:embedding
QUERY_EMBEDDING_CACHE_TTL_SECONDS=604800
CHUNK_EMBEDDING_CACHE_TTL_SECONDS=0
EMBEDDING_CACHE_FAIL_OPEN_ON_REDIS_ERROR=0

# Shared Grafana (:3002); Prometheus storage remains project-specific.
ETERNAL_WORLD_PROMETHEUS_URL=http://host.docker.internal:9090
ETERNAL_WORLD_DASHBOARD_DIR=../eternal-world/monitoring/grafana/dashboards
